{
  "name": "so",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.2",
  "bin": {
    "so": "bin/so"
  },
  "scripts": {
    "dev": "bun src/app/main.ts",
    "check": "biome check . && bun --bun run tsc --noEmit -p . && bun --bun run knip && bun test src scripts test/boundaries.test.ts test/repo.test.ts test/vim",
    "test:ci": "bun test --parallel --timeout=20000 test/ui test/integration test/e2e",
    "bench": "bun scripts/bench-gate.ts",
    "build": "bun build --compile src/app/main.ts src/workspace/index-worker.ts src/workspace/sqlite-worker.ts src/ui/image-scale-worker.ts --outfile dist/so",
    "record:vim": "bun scripts/record-vim.ts",
    "record:intro": "bun scripts/record-intro.ts",
    "sandbox": "bun scripts/sandbox.ts"
  },
  "dependencies": {
    "@opentui/core": "0.6.6",
    "@resvg/resvg-wasm": "2.6.2",
    "beautiful-mermaid": "1.1.3",
    "highlight.js": "11.12.0",
    "ignore": "7.0.12",
    "katex": "0.19.0",
    "lowlight": "3.3.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "12.2.0",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "toml-eslint-parser": "1.0.3",
    "vscode-jsonrpc": "9.0.3",
    "vscode-languageserver-protocol": "3.18.4",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/bun": "1.4.3",
    "@biomejs/biome": "2.5.15",
    "knip": "6.41.0",
    "@xterm/headless": "6.0.0"
  },
  "patchedDependencies": {
    "beautiful-mermaid@1.1.3": "patches/beautiful-mermaid@1.1.3.patch"
  }
}
