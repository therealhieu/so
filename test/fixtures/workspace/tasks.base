formulas:
  late: 'done == false && status != "doing"'
properties:
  status:
    displayName: Status
views:
  - type: table
    name: All tasks
    order:
      - file.name
      - status
      - due
      - done
    sort:
      - property: due
        direction: ASC
    summaries:
      due: Earliest
      done: Checked
  - type: table
    name: By status
    order:
      - file.name
      - status
      - due
    groupBy:
      property: status
      direction: ASC
  - type: table
    name: Late
    order:
      - file.name
      - formula.late
    groupBy:
      property: formula.late
      direction: ASC
  - type: cards
    name: Cards
